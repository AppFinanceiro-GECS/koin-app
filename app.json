{
  "expo": {
    "name": "Koin",
    "slug": "koin",
    "version": "0.1.0",
    "scheme": "koin",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080512",
    "primaryColor": "#7c3aed",
    "ios": {
      "bundleIdentifier": "com.koin.app",
      "supportsTablet": false,
      "userInterfaceStyle": "dark",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.koin.app",
      "userInterfaceStyle": "dark",
      "backgroundColor": "#080512",
      "adaptiveIcon": {
        "backgroundColor": "#080512",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#080512"
        }
      ],
      "expo-font",
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "cameraPermission": "O Koin usa a câmera para fotografar faturas, notas fiscais e boletos.",
          "photosPermission": "O Koin acessa suas fotos para você escolher a foto de uma fatura ou nota fiscal.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "superappkoin",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9d8026b4-723d-4f73-87f2-16c484f8585e"
      }
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/9d8026b4-723d-4f73-87f2-16c484f8585e"
    }
  }
}
